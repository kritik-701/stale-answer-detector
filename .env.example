# --- Bifrost gateway (where all LLM calls go) ---
BIFROST_URL=http://localhost:8080
BIFROST_CHAT_PATH=/v1/chat/completions
BIFROST_API_KEY=
# provider/model as configured in Bifrost
ANALYSIS_MODEL=openai/gpt-4o-mini

# --- Tavily (live web verification) ---
TAVILY_API_KEY=tvly-your-key-here
TAVILY_DEPTH=basic

# --- Tuning ---
MAX_CLAIMS=5
MAX_SOURCES=5
STALE_THRESHOLD=40
DB_PATH=data/checks.db
